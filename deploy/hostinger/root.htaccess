Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route all requests into Laravel's public/ folder (shared hosting web root).
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Block direct access to sensitive files if the web root contains the full app.
<Files .env>
    Require all denied
</Files>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
