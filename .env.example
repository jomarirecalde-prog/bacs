APP_NAME="BACS DTR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local XAMPP example: http://localhost/BACS/public
APP_URL=http://localhost/BACS/public
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Set PERF_LOG=true locally to write slow-request warnings to storage/logs/performance.log
PERF_LOG=false
PERF_SLOW_REQUEST_MS=400
PERF_SLOW_QUERY_MS=100
PERF_EXCESSIVE_QUERIES=25

# Local XAMPP: use mysql. Remote Neon example commented below.
DB_CONNECTION=mysql

# Neon PostgreSQL (production / shared staging)
# DB_CONNECTION=pgsql
# DB_HOST=ep-xxxxx.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=bacs_db
# DB_USERNAME=neondb_owner
# DB_PASSWORD=
# DB_SSLMODE=require

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bacs_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Local XAMPP: use file session/cache so login does not wait on remote DB every request.
# Production (Vercel/serverless): use database — cookie sessions can exceed size limits and cause 419 errors.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_WARN_BEFORE=5
SESSION_ENCRYPT=false
# Production HTTPS: set SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=
# SESSION_SAME_SITE=lax
# Scope session cookies to the Laravel public directory (XAMPP subdirectory install).
SESSION_PATH=/BACS/public
# Leave empty; do not set to the literal string "null".
SESSION_DOMAIN=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Employee photos: leave empty to auto-pick s3 when AWS_BUCKET is set, else public.
# On Vercel/production set EMPLOYEE_PHOTOS_DISK=s3 and configure AWS_* below.
EMPLOYEE_PHOTOS_DISK=
QUEUE_CONNECTION=database

# Use file locally (XAMPP). Use database on serverless/production if needed.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=bacs-dtr
REVERB_APP_KEY=bacs-local-key
REVERB_APP_SECRET=bacs-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
